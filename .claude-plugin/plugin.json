{
  "name": "notion-arena",
  "version": "0.1.0",
  "description": "Notion Arena — the component registry for Notion. 167 components: 156 widgets + 11 native recipes. Browse, configure, and install from your AI agent.",
  "author": {
    "name": "SynergyFlowLabs",
    "url": "https://github.com/SynergyFlowLabs/notion-arena"
  },
  "homepage": "https://github.com/SynergyFlowLabs/notion-arena#readme",
  "repository": "https://github.com/SynergyFlowLabs/notion-arena",
  "license": "MIT",
  "keywords": [
    "notion",
    "components",
    "widgets",
    "notion-arena",
    "shadcn",
    "registry",
    "mcp",
    "dashboard",
    "productivity"
  ],
  "skills": [
    "./skills/notion-arena/SKILL.md",
    "./.claude/skills/notion-arena/SKILL.md"
  ],
  "mcpServers": {
    "notion-arena": {
      "command": "npx",
      "args": ["-y", "notion-arena-mcp"],
      "env": {
        "NOTION_ARENA_SITE_URL": "${NOTION_ARENA_SITE_URL:-https://notionarena.vercel.app}"
      }
    }
  }
}
