{
  "name": "notion-arena",
  "version": "0.2.0",
  "private": true,
  "description": "Notion Arena — a component registry for Notion. 143 pre-built, embeddable widgets and native database recipes for Notion dashboards.",
  "homepage": "https://notionarena.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SynergyFlowLabs/notion-components.git"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:widgets": "node scripts/check-widgets.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "generate:mcp-catalog": "node scripts/generate-mcp-catalog.mjs",
    "build:mcp": "npm run generate:mcp-catalog && cd mcp && npm install && npm run build",
    "dev:mcp": "cd mcp && npm run dev"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
