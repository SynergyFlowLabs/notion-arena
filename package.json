{
  "name": "notion-arena",
  "version": "0.2.0",
  "private": true,
  "description": "Notion Arena — a component registry for Notion. 203 pre-built, embeddable widgets and native database recipes for Notion dashboards.",
  "homepage": "https://notionarena.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SynergyFlowLabs/notion-arena.git"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:widgets": "node scripts/check-widgets.mjs",
    "check:sync": "node scripts/check-sync.mjs && node scripts/check-bridge.mjs",
    "diagrams": "node scripts/export-diagrams.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:mcp-catalog": "node scripts/generate-mcp-catalog.mjs",
    "build:mcp": "npm run generate:mcp-catalog && cd mcp && npm install && npm run build",
    "dev:mcp": "cd mcp && npm run dev",
    "check:components": "node scripts/check-components.mjs",
    "check:coverage": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@notionhq/client": "^5.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.64.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
